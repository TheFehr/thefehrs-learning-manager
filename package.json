{
  "name": "thefehrs-learning-manager",
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-types": "node scripts/generate-external-types.mjs",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:run": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:verify": "bash scripts/e2e-verify.sh",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@league-of-foundry-developers/foundry-vtt-types": "^13.345.1",
    "@playwright/test": "^1.59.1",
    "@release-it/bumper": "^7.0.5",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@vitest/coverage-v8": "4.1.3",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.60.0",
    "release-it": "^19.2.4",
    "sass-embedded": "^1.97.3",
    "svelte": "^5.20.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.1",
    "vitest": "4.1.3"
  },
  "lint-staged": {
    "**/*.{ts,json,js,scss,md,mjs,yml}": "npm run fmt",
    "{src,tests}/**/*.{ts,js}": "oxlint"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
