{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["@league-of-foundry-developers/foundry-vtt-types", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "fvtt-types/configuration": [
        "./node_modules/@league-of-foundry-developers/foundry-vtt-types/src/configuration/index.d.mts"
      ],
      "@dnd5e/*": ["./external-dts/dnd5e/*"],
      "@tidy5e/*": ["./external-dts/tidy-5e/*"]
    },
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["externals/tidy-5e/**"]
}
