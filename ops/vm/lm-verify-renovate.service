# Install: copy this file to /etc/systemd/system/lm-verify-renovate.service
# (a real copy, NOT a symlink into this repo checkout - see foundry-playwright's
# ops/vm/foundry-verify.service for why: this unit controls User=/ExecStart=
# for what runs on the VM, and must only change via a deliberate manual step).
# Then: systemctl daemon-reload && systemctl enable --now lm-verify-renovate.timer
#
# --- Two identities, deliberately ---
# `foundry-verify` is the same credentialed system user as foundry-playwright's
# own nightly job - it has a repo-scoped `gh` token and an SSH commit-signing
# key in its $HOME. verify-renovate-prs.sh only ever runs `git
# fetch`/`push`/`gh pr ...` as this user - plain network operations, never
# candidate-branch code.
#
# `lm-verify-runner` is a second, unprivileged system user created
# specifically for this job. It runs `npm ci`, the build, and the actual
# Docker/Podman e2e suite - i.e. everything that executes code from a
# Renovate PR's dependency bump. It has no gh token, no SSH key, and no
# access to foundry-verify's $HOME, so a compromised dependency's
# install/postinstall script (CWE-829) has nothing to steal that could push,
# merge, or forge commits as this identity. It does get the Foundry VTT test
# credentials the e2e suite needs (never GitHub credentials) - as of
# foundry-playwright >=1.3.2, the library reads those from process.env
# directly and no longer needs a .env file in the checkout at all, so this
# job just gives lm-verify-runner a narrow read-only grant on
# foundry-playwright's own existing .env (see the setfacl line below) and
# sources it directly. No copy, nothing to drift when a credential rotates,
# and no group-shared secret file sitting in this checkout.
#
# One-time setup:
#   sudo useradd --system --create-home --shell /usr/sbin/nologin lm-verify-runner
#   # Non-overlapping range from foundry-verify's own 200000-265535 (see
#   # foundry-verify.service) - two rootless-Podman users sharing a subuid
#   # range would let one forge UIDs inside the other's user namespace.
#   sudo usermod --add-subuids 300000-365535 --add-subgids 300000-365535 lm-verify-runner
#   sudo loginctl enable-linger lm-verify-runner
#   sudo -u lm-verify-runner git config --global user.name "lm-verify-runner"
#   sudo -u lm-verify-runner git config --global user.email "lm-verify-runner@localhost"
#   # (no signing key for this identity - main has no signature requirement,
#   # unlike foundry-playwright's repo, so there's nothing to sign)
#
#   # Shared group so foundry-verify (push/merge) and lm-verify-runner
#   # (checkout/build/test) can both read/write the one checkout without
#   # sharing an identity. setgid propagates the group to files either side
#   # creates; g+w plus each identity's own `umask 002` keeps them writable
#   # by both.
#   sudo groupadd lm-verify-shared
#   sudo usermod -aG lm-verify-shared foundry-verify
#   sudo usermod -aG lm-verify-shared lm-verify-runner
#   sudo mkdir -p /opt/thefehrs-learning-manager
#   sudo chown foundry-verify:lm-verify-shared /opt/thefehrs-learning-manager
#   sudo chmod 2775 /opt/thefehrs-learning-manager
#   sudo -u foundry-verify git clone https://github.com/TheFehr/thefehrs-learning-manager.git /opt/thefehrs-learning-manager
#   sudo find /opt/thefehrs-learning-manager -type d -exec chmod g+s {} +
#   sudo chgrp -R lm-verify-shared /opt/thefehrs-learning-manager
#   sudo chmod -R g+w /opt/thefehrs-learning-manager
#
#   # Narrow read-only grant on foundry-playwright's existing .env (owned
#   # foundry-verify:foundry-verify, mode 600, untouched otherwise) - the
#   # ONLY access lm-verify-runner gets to it. Requires the `acl` package.
#   sudo apt install -y acl
#   sudo setfacl -m u:lm-verify-runner:r /opt/foundry-playwright/.env
#
# No docker-group membership for either user, same reasoning as
# foundry-verify.service: this job fetches and executes third-party
# FoundryVTT/module/dependency content on every run, and docker-group access
# is root-equivalent. Containers run rootless via the same podman-docker
# wrapper already set up for foundry-verify - lm-verify-runner just needs
# its own subuid/subgid range (above), not a separate package install.

[Unit]
Description=Verify e2e for open thefehrs-learning-manager Renovate PRs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=foundry-verify
Group=foundry-verify
WorkingDirectory=/opt/thefehrs-learning-manager
ExecStart=/opt/thefehrs-learning-manager/ops/vm/verify-renovate-prs.sh
# The script stops after its first successful merge (see its comments - a
# merge rebases every other open PR, invalidating anything else verified
# this run) and caps failed attempts at MAX_ATTEMPTS_PER_RUN=3, so worst
# case is 3 failed ~30-35min verify runs in a row. Sized with real margin
# over that, not for an open-ended hang - a run still going after 3h is
# stuck, not just slow.
TimeoutStartSec=3h
# Rootless Podman's conmon deliberately survives its parent dying, so a
# TimeoutStartSec kill (or any other abnormal exit) can leave a container
# running - which then holds verify-renovate-prs.sh's flock open via an
# inherited fd, silently blocking every future run until someone notices.
# The actual Foundry containers run under lm-verify-runner's namespace (see
# the identity split above), not foundry-verify's, so cleanup has to reach
# both; force-remove anything either identity's own containers left behind,
# every time the service stops, regardless of why.
ExecStopPost=/bin/sh -c 'runuser -u lm-verify-runner -- podman ps -aq --filter "name=foundry-playwright-" | xargs -r runuser -u lm-verify-runner -- podman rm -f; podman ps -aq --filter "name=foundry-playwright-" | xargs -r podman rm -f'
